# PILOT Library — environment
# Copy to .env.local and fill in if you want photos streamed live from Drive.
# Without these values the app serves the bundled catalogue snapshot.

# Google Drive folder that holds the product photos ("Pilot-library")
GOOGLE_DRIVE_FOLDER_ID=1lda7ww3UybIHobPLm6ZecWaJr4jepiCH

# Google Cloud API key with the Drive API enabled (folder shared as viewer)
GOOGLE_DRIVE_API_KEY=

# Public origin, used for Open Graph images and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000
