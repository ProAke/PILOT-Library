# PILOT Library — environment
# Copy to .env.local and fill in if you want photos streamed live from Drive.
# Without these values the app serves the bundled catalogue snapshot.

# Google Drive folder that holds the product photos ("Pilot-library")
GOOGLE_DRIVE_FOLDER_ID=1lda7ww3UybIHobPLm6ZecWaJr4jepiCH

# Google Cloud API key with the Drive API enabled (folder shared as viewer)
GOOGLE_DRIVE_API_KEY=

# Public origin, used for Open Graph images and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Operations (admin + Google Sheets as database) -------------------
# Service account JSON (single line) OR the split pair below.
# Share the sheet & Drive folder with the service-account email (Writer).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# The sheet that holds slug|name|price|stock|status|category|updated_at
PRODUCTS_SHEET_ID=
# Passcode for the admin console (admin/ app)
ADMIN_PASSCODE=
